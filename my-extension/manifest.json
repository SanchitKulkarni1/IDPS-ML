{
  "manifest_version": 3,
  "name": "CyberView",
  "version": "1.0",
  "description": "CyberView ML-Powered Network Intrusion Detection & Prevention Dashboard",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": "icons/icon48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
